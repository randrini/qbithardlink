# Copy this file to .env and fill in your local values.
# .env is git-ignored so secrets never get committed.

# ── qBittorrent WebUI credentials ─────────────────────────────────────────
QB_URL=http://192.168.1.116:8084
QB_USER=bidalos
QB_PASS=your-password

# ── File ownership (Unraid default is nobody/users = 99:100) ─────────────
PUID=99
PGID=100

# ── Paths (must match the bind-mounts in docker-compose.yml) ─────────────
# Library root for hardlinks. Must be on the SAME filesystem as qBittorrent downloads.
LIBRARY_ROOT=/data/media/books

# ── Daemon behaviour ────────────────────────────────────────────────────
QB_SOURCE_CATEGORY=books
POLL_INTERVAL=10
LOG_LEVEL=INFO

# ── Optional metadata API keys ───────────────────────────────────────────
GOOGLE_BOOKS_API_KEY=
COMICVINE_API_KEY=

# ── FlareSolverr / Trawl endpoint (for Cloudflare-protected BD providers)
FLARESOLVERR_URL=http://192.168.1.116:8193
