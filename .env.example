# Copy this file to .env and fill in your local values.
# .env is git-ignored so secrets never get committed.
#
# CONFIGURATION HIERARCHY (highest priority wins):
#   1. .env                 → Docker runtime env vars (secrets + host paths)
#   2. config.local.yaml    → Optional YAML overrides (provider rate limits, etc.)
#   3. config.yaml          → Stock defaults (edit only if not using Docker)
#
# For Docker deployments, edit THIS FILE (.env). Do NOT edit docker-compose.yml
# or config.yaml for routine settings.

# ── qBittorrent WebUI credentials ─────────────────────────────────────────
QB_URL=http://192.168.1.116:8084
QB_USER=bidalos
QB_PASS=your-password

# ── File ownership (Unraid default is nobody/users = 99:100) ─────────────
PUID=99
PGID=100

# ── Paths (must match the bind-mount in docker-compose.yml) ─────────────
# Single host share mounted at /data/books in the container. Both qBittorrent
# downloads and the library live inside it so hardlinks share the same inode.
BOOKS_SHARE_PATH=/mnt/user/data/books
# Container-side paths (rarely need changing; must be under /data/books).
DOWNLOAD_PATH=/data/books/torrents
LIBRARY_ROOT=/data/books/library

# ── Daemon behaviour ────────────────────────────────────────────────────
QB_SOURCE_CATEGORY=books
POLL_INTERVAL=10
LOG_LEVEL=INFO

# ── Optional metadata API keys ───────────────────────────────────────────
GOOGLE_BOOKS_API_KEY=
COMICVINE_API_KEY=

# ── FlareSolverr / Trawl / Byparr endpoint (for Cloudflare-protected sites)
# Must point to a private/container host; public URLs are rejected for SSRF safety.
FLARESOLVERR_URL=http://192.168.1.116:8193
FLARESOLVERR_RETRIES=3
FLARESOLVERR_BACKOFF_SECONDS=2.0

# ── Metadata provider budget (seconds) ────────────────────────────────────
# Total time to spend querying providers for one torrent. The budget is split
# across active providers with a 20 s minimum per call.
METADATA_TIMEOUT_SECONDS=45

# ── Hardlinking ─────────────────────────────────────────────────────────
HARDLINK_ENABLED=true
HARDLINK_SCRIPT=/app/hardlink.sh

# ── Logging ─────────────────────────────────────────────────────────────
LOG_FILE=/app/logs/classifier.log

# ── LLM arbiter (optional, OFF by default) ───────────────────────────────
# When LLM_ENABLED=true, the LLM is the PRIMARY classifier. It runs before
# metadata providers / regex and its verdict is trusted at high confidence.
# If the LLM is unreachable or returns nothing, the classifier falls back to
# metadata providers → regex → extension signals → default ebooks.
# Set LLM_ENABLED=true to activate.
# Supported backends:
#   Gemini v1beta (native):
#     LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
#     LLM_API_KEY=your-gemini-key
#   OpenAI-compatible (OpenAI, OpenRouter, etc.):
#     LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
#     LLM_API_KEY=sk-...
#   Ollama (local):
#     LLM_ENDPOINT=http://host.docker.internal:11434/api/chat
#     LLM_API_KEY=
LLM_ENABLED=false
LLM_MODE=fallback
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=
LLM_TIMEOUT=30
LLM_COOLDOWN_MINUTES=60
