# Copy this file to .env and fill in your local values.
# .env is git-ignored so secrets never get committed.
#
# CONFIGURATION HIERARCHY (highest priority wins):
#   1. .env                 → Docker runtime env vars (secrets + host paths)
#   2. config.local.yaml    → Optional YAML overrides (provider rate limits, etc.)
#   3. config.yaml          → Stock defaults (edit only if not using Docker)
#
# For Docker deployments, edit THIS FILE (.env). Do NOT edit docker-compose.yml
# or config.yaml for routine settings.

# ── qBittorrent WebUI credentials ─────────────────────────────────────────
QB_URL=http://192.168.1.116:8084
QB_USER=bidalos
QB_PASS=your-password

# ── File ownership (Unraid default is nobody/users = 99:100) ─────────────
PUID=99
PGID=100

# ── Paths (must match the bind-mounts in docker-compose.yml) ─────────────
# Host paths mounted into the container. Must be on the SAME filesystem for hardlinks.
DOWNLOAD_PATH=/mnt/user/data/torrents
LIBRARY_PATH=/mnt/user/media/books
# Container-side library root (rarely needs changing; must match the compose mount target).
LIBRARY_ROOT=/data/media/books

# ── Daemon behaviour ────────────────────────────────────────────────────
QB_SOURCE_CATEGORY=books
POLL_INTERVAL=10
LOG_LEVEL=INFO

# ── Optional metadata API keys ───────────────────────────────────────────
GOOGLE_BOOKS_API_KEY=
COMICVINE_API_KEY=

# ── FlareSolverr / Trawl endpoint (for Cloudflare-protected BD providers)
FLARESOLVERR_URL=http://192.168.1.116:8193

# ── LLM final-arbiter (optional, OFF by default) ─────────────────────────
# When metadata providers, regex rules, and extension signals all fail to
# classify a release, the classifier makes one final call to this LLM.
# Set LLM_ENABLED=true to activate.
#
# Supported backends:
#   Gemini v1beta (native):
#     LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
#     LLM_API_KEY=your-gemini-key
#   OpenAI-compatible (OpenAI, OpenRouter, etc.):
#     LLM_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
#     LLM_API_KEY=sk-...
#   Ollama (local):
#     LLM_ENDPOINT=http://host.docker.internal:11434/api/chat
#     LLM_API_KEY=
LLM_ENABLED=false
LLM_MODE=fallback
LLM_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
LLM_MODEL=gemini-2.0-flash
LLM_API_KEY=
LLM_TIMEOUT=30
